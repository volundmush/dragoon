# Safe development defaults. Put personal overrides and secrets in .env.local.

COMPOSE_PROJECT_NAME=dragoon

SURREALDB_IMAGE=surrealdb/surrealdb:v3
SURREALDB_PORT=8000
SURREALDB_URL=ws://surrealdb:8000/rpc
SURREALDB_HOST_URL=ws://localhost:8000/rpc
SURREALDB_HTTP_URL=http://surrealdb:8000
SURREALDB_NS=dragoon
SURREALDB_DB=dev
SURREALDB_USER=root
SURREALDB_PASS=root

SURREAL_PATH=rocksdb:/data/dragoon.db
SURREAL_BIND=0.0.0.0:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NAMESPACE=dragoon
SURREAL_DATABASE=dev
SURREAL_DEFAULT_NAMESPACE=dragoon
SURREAL_DEFAULT_DATABASE=dev

SURREALMCP_IMAGE=surrealdb/surrealmcp:latest
SURREALMCP_PORT=8080
SURREAL_MCP_BIND_ADDRESS=0.0.0.0:8080
SURREAL_MCP_SERVER_URL=http://localhost:8080
SURREAL_MCP_AUTH_DISABLED=true

# Local TLS defaults. Run ./makekey.sh to generate these files.
TLS_CERT_PATH=.certs/localhost.crt
TLS_KEY_PATH=.certs/localhost.key
TLS_HOSTNAME=localhost

# Process defaults.
ENGINE_WORKER_ID=engine-dev

# Auth HTTP(S) listener defaults.
AUTH_HTTP_HOST=127.0.0.1
AUTH_HTTP_PORT=7001
AUTH_HTTP_PROTOCOL=auto
AUTH_HTTPS_ENABLED=false
AUTH_HTTPS_HOST=127.0.0.1
AUTH_HTTPS_PORT=7443

# Portal HTTP(S) listener defaults.
PORTAL_HTTP_HOST=127.0.0.1
PORTAL_HTTP_PORT=7002
PORTAL_HTTP_PROTOCOL=auto
PORTAL_HTTPS_ENABLED=false
PORTAL_HTTPS_HOST=127.0.0.1
PORTAL_HTTPS_PORT=7444

# Termgate TELNET/TELNETS listener defaults.
TERMGATE_ADDRESS=127.0.0.1
TELNET_ENABLED=true
TELNET_HOST=127.0.0.1
TELNET_PORT=2323
TELNETS_ENABLED=false
TELNETS_HOST=127.0.0.1
TELNETS_PORT=9923
