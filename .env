# Safe development defaults. Put personal overrides and secrets in .env.local.

COMPOSE_PROJECT_NAME=dragoon

SURREALDB_IMAGE=surrealdb/surrealdb:v3
SURREALDB_PORT=8000
SURREALDB_URL=ws://surrealdb:8000/rpc
SURREALDB_HOST_URL=ws://localhost:8000/rpc
SURREALDB_HTTP_URL=http://surrealdb:8000
SURREALDB_NS=dragoon
SURREALDB_DB=dev
SURREALDB_USER=root
SURREALDB_PASS=root

SURREAL_PATH=rocksdb:/data/dragoon.db
SURREAL_BIND=0.0.0.0:8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NAMESPACE=dragoon
SURREAL_DATABASE=dev
SURREAL_DEFAULT_NAMESPACE=dragoon
SURREAL_DEFAULT_DATABASE=dev

SURREALMCP_IMAGE=surrealdb/surrealmcp:latest
SURREALMCP_PORT=8080
SURREAL_MCP_BIND_ADDRESS=0.0.0.0:8080
SURREAL_MCP_SERVER_URL=http://localhost:8080
SURREAL_MCP_AUTH_DISABLED=true
